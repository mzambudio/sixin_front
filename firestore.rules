rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPERS GLOBALES
    // =========================================================
    function signedIn() {
      return request.auth != null;
    }

    function listData(listId) {
      return get(/databases/$(database)/documents/lists/$(listId)).data;
    }

    function isAdminOf(listId) {
      return signedIn()
        && (
          request.auth.uid == listData(listId).createdBy
          || (
            listData(listId).admins is list
            && listData(listId).admins.hasAny([request.auth.uid])
          )
        );
    }

    // =========================================================
    // USERS
    // =========================================================
    match /users/{uid} {

      // ---------- Documento principal del usuario ----------
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if signedIn() && request.auth.uid == uid;

      // ---------- Settings ----------
      match /settings/{docId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
      }

      // ---------- Invites ----------
      match /invites/{listId} {
        allow get, list: if signedIn() && request.auth.uid == uid;

        allow create: if signedIn()
          && request.resource.data.listId == listId
          && request.resource.data.fromUid == request.auth.uid
          && isAdminOf(listId);

        allow delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // =========================================================
    // USERNAMES
    // =========================================================
    match /usernames/{uname} {
      allow read: if signedIn();

      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(uname))
        && request.resource.data.uid == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;

      allow update: if false;
    }

    // =========================================================
    // LISTS
    // =========================================================
    match /lists/{listId} {

      // ---------- Helpers locales ----------
      function listDoc() {
        return get(/databases/$(database)/documents/lists/$(listId)).data;
      }

      function isPublicList() {
        return listDoc().visibility == "public";
      }

      function isAdmin() {
        return signedIn()
          && (
            request.auth.uid == listDoc().createdBy
            || (
              listDoc().admins is list
              && listDoc().admins.hasAny([request.auth.uid])
            )
          );
      }

      function isMember(uid) {
        return signedIn()
          && exists(/databases/$(database)/documents/lists/$(listId)/members/$(uid));
      }

      function hasInvite() {
        return signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/invites/$(listId));
      }

      function hasJoinRequest() {
        return signedIn()
          && exists(/databases/$(database)/documents/lists/$(listId)/requests/$(request.auth.uid));
      }

      function hasPreviewAccess() {
        return signedIn()
          && exists(/databases/$(database)/documents/lists/$(listId)/preview_access/$(request.auth.uid));
      }

      function canPreviewPrivate() {
        return isAdmin()
          || isMember(request.auth.uid)
          || hasInvite()
          || hasJoinRequest()
          || hasPreviewAccess();
      }

      // ---------- Reglas documento principal ----------
      allow get: if isPublicList() || canPreviewPrivate();
      allow list: if true;
      allow create: if signedIn();
      allow delete: if isAdmin();

      // ---------- Helpers de update ----------
      function isSelfJoinUpdate() {
        return signedIn()
          && listDoc().joinPolicy == "open"
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.hasAny([request.auth.uid]);
      }

      function isInviteJoinUpdate() {
        return signedIn()
          && hasInvite()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.hasAny([request.auth.uid]);
      }

      function isSelfLeaveUpdate() {
        return signedIn()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberUids', 'admins'])
          && (resource.data.memberUids is list && resource.data.memberUids.hasAny([request.auth.uid]))
          && !request.resource.data.memberUids.hasAny([request.auth.uid])
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1;
      }

      allow update: if isAdmin()
        || isSelfJoinUpdate()
        || isInviteJoinUpdate()
        || isSelfLeaveUpdate();

      // =====================================================
      // LISTS / MEMBERS
      // =====================================================
      match /members/{uid} {

        function isSelfPreferredPositionUpdate() {
          return signedIn()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['preferredPosition']);
        }

        allow get, list: if isPublicList() || canPreviewPrivate();

        allow create: if signedIn()
          && (request.auth.uid == uid || isAdmin());

        allow delete: if signedIn()
          && (request.auth.uid == uid || isAdmin());

        allow update: if isAdmin() || isSelfPreferredPositionUpdate();
      }

      // =====================================================
      // LISTS / REQUESTS
      // =====================================================
      match /requests/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow list: if isAdmin();

        allow create: if signedIn()
          && request.auth.uid == uid
          && !(listDoc().memberUids is list && listDoc().memberUids.hasAny([uid]));

        allow delete: if signedIn()
          && (request.auth.uid == uid || isAdmin());

        allow update: if false;
      }

      // =====================================================
      // LISTS / PREVIEW_ACCESS
      // =====================================================
      match /preview_access/{uid} {
        allow get, delete: if signedIn() && request.auth.uid == uid;

        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.codeHash is string
          && exists(/databases/$(database)/documents/list_codes/$(request.resource.data.codeHash))
          && get(/databases/$(database)/documents/list_codes/$(request.resource.data.codeHash)).data.listId == listId;

        allow list: if false;
        allow update: if false;
      }
    }

    // =========================================================
    // LIST_CODES
    // =========================================================
    match /list_codes/{codeHash} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.listId is string
        && request.resource.data.createdBy == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.listId is string
        && (
          request.auth.uid
            == get(/databases/$(database)/documents/lists/$(resource.data.listId)).data.createdBy
          || get(/databases/$(database)/documents/lists/$(resource.data.listId)).data.admins
            .hasAny([request.auth.uid])
        );

      allow update: if false;
    }
  }
}